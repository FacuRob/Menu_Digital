# URL del backend en Render (SIN /api al final; el código ya lo agrega).
VITE_API_URL=https://url-menu.onrender.com

# URL del menú público (botón "Ver Menú" y QR), SIN barra final. El código
# arma /menu/:slug. Ej. producción: https://dinexflow.com.ar
VITE_MENU_URL=https://dinexflow.com.ar

# Google Sign-In: MISMO Client ID que GOOGLE_CLIENT_ID del backend (opcional).
VITE_GOOGLE_CLIENT_ID=
